+def operator_disabled_view(path, now):
+    """Root-owned descriptive stop record; never a trading authorization."""
+    marker = Path(path).with_name('disabled.json')
+    try:
+        metadata = marker.lstat()
+    except FileNotFoundError:
+        return None
+    try:
+        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
+                or metadata.st_mode & 0o022 or metadata.st_size > 1024):
+            raise ValueError('untrusted_disable_record')
+        value = json.loads(marker.read_text())
+        if (set(value) != {'contract', 'state', 'disabled_at', 'last_report_generated_at'}
+                or value['contract'] != 'qwen-descriptive-operator-state-v1'
+                or value['state'] != 'DISABLED_BY_OPERATOR'
+                or analytics.timestamp(value['disabled_at']) > now
+                or analytics.timestamp(value['last_report_generated_at']) > analytics.timestamp(value['disabled_at'])):
+            raise ValueError('invalid_disable_record')
+        return view_state('disabled', disabled_at=value['disabled_at'],
+            generated_at=value['last_report_generated_at'], next_scheduled_at=None)
+    except (OSError, ValueError, TypeError, KeyError):
+        # A malformed stop record cannot silently enable a model call.
+        return view_state('unverifiable', next_scheduled_at=None)
+
