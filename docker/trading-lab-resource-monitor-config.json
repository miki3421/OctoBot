{
  "disks": {
    "root": "/",
    "lab": "/var/lib/libvirt/trading-ai-lab"
  },
  "containers": [
    "octobot-local",
    "octobot-v13-research-capture",
    "octobot-v13-research-producer",
    "octobot-v13-research-issuer",
    "octobot-v13-research-executor",
    "octobot-market-observer",
    "octobot-scalping-observer",
    "octobot-v13-forks",
    "octobot-btc-intraday-paper",
    "octobot-v13-m1-paper"
  ],
  "collectors": {
    "market": {
      "path": "/root/auto_trading_sys/octobot-local/shadow/market/health.json",
      "timestamp_keys": [
        "last_success_at"
      ],
      "warn_after_seconds": 1800
    },
    "scalping_book": {
      "path": "/root/auto_trading_sys/octobot-local/scalping/health.json",
      "timestamp_keys": [
        "last_book_at"
      ],
      "warn_after_seconds": 120
    },
    "scalping_trade": {
      "path": "/root/auto_trading_sys/octobot-local/scalping/health.json",
      "timestamp_keys": [
        "last_trade_at"
      ],
      "warn_after_seconds": 120
    },
    "paper": {
      "path": "/root/auto_trading_sys/octobot-local/v13-paper/research/execution/health-research.json",
      "timestamp_keys": [
        "last_success_at"
      ],
      "warn_after_seconds": 300
    }
  },
  "forks": {
    "path": "/root/auto_trading_sys/octobot-local/v13-paper/forks-ui/comparison.json",
    "heartbeat_warn_after_seconds": 180,
    "valuation_warn_after_seconds": 420
  },
  "paper_accounts": {
    "m1": {
      "path": "/root/auto_trading_sys/octobot-local/v13-paper/m1-paper-ui/account.json",
      "uid": 30943,
      "heartbeat_warn_after_seconds": 180,
      "valuation_warn_after_seconds": 300
    },
    "intraday": {
      "path": "/root/auto_trading_sys/octobot-local/v13-paper/intraday-ui/account.json",
      "uid": 30943,
      "heartbeat_warn_after_seconds": 180,
      "valuation_warn_after_seconds": 300
    }
  }
}
