[Unit]
Description=Trading AI Lab passive resource and collection monitor
After=docker.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/trading-lab-resource-monitor-v1
ExecStartPre=/usr/bin/sha256sum --check files.sha256
ExecStart=/usr/bin/python3 -B monitor.py --config config.json --output /var/lib/libvirt/trading-ai-lab/resource-monitor
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/libvirt/trading-ai-lab/resource-monitor
InaccessiblePaths=-/root/.ops -/root/.ssh -/run/secrets
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=128M
CPUQuota=10%
Nice=15
TasksMax=12
TimeoutStartSec=45
Restart=no
