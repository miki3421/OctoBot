[Unit]
Description=Trading AI Lab SMTP alerts and recovery notifications
After=network-online.target trading-lab-resource-monitor.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/trading-lab-mail-alerts-v1
LoadCredential=smtp:/root/.ops/lab-smtp.credential
ExecStartPre=/usr/bin/sha256sum --check files.sha256
ExecStart=/usr/bin/python3 -B alerts.py --credential %d/smtp --monitor-status /var/lib/libvirt/trading-ai-lab/resource-monitor/status.json --state /var/lib/libvirt/trading-ai-lab/mail-alerts/state.sqlite
UMask=0077
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/libvirt/trading-ai-lab/mail-alerts
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=64M
CPUQuota=10%
Nice=15
TasksMax=8
TimeoutStartSec=120
Restart=no
